    <!-- Privacy (onboarding step 3 and Settings › Qué datos se envían), documentación §8 -->
    <string name="privacy_title">What data is sent</string>
    <string name="privacy_intro">To keep my roasts witty, I only pass my intermediate server the app name (or «another app» if you added it), how many minutes you\'ve spent, your phone\'s tilt angle, and the alert level and reason. It forwards that to an AI service (DeepSeek). Nothing else.</string>
    <string name="privacy_sent_title">What the AI service receives</string>
    <string name="privacy_sent_app">The app in use: TikTok, Instagram, YouTube, or Facebook. If it\'s an app you added, just «another app». Never the package name or your app\'s name.</string>
    <string name="privacy_sent_minutes">Usage minutes. My intermediate server rounds them to multiples of 5 (up to 240) before sending.</string>
    <string name="privacy_sent_angle">The phone\'s tilt angle. My intermediate server rounds it to multiples of 5 (between 0 and 90) before sending.</string>
    <string name="privacy_sent_level">The alert level and reason.</string>
    <string name="privacy_never_title">What never leaves the phone</string>
    <string name="privacy_never_identity">Your name, account, location, or device identifier.</string>
    <string name="privacy_never_content">What you see on the screen.</string>
    <string name="privacy_never_history">Your history and stats: they stay on the phone.</string>
    <string name="privacy_ip_title">Your IP address</string>
    <string name="privacy_ip_body">It does reach my intermediate server, which communicates with the AI. The AI doesn\'t get it: only Cloudflare\'s IP shows up there.</string>
    <string name="privacy_limits_note">What DeepSeek does with that data is out of my control. That\'s why I send the bare minimum.</string>
    <string name="privacy_ai_switch">Use AI for Likka\'s messages</string>
    <string name="privacy_ai_switch_hint">If turned off, I\'ll keep working with local phrases and without an internet connection.</string>

    <!-- Onboarding (design system §3.1) -->
    <string name="onboarding_start">Get started</string>
    <string name="onboarding_next">Continue</string>
    <string name="onboarding_back">Back</string>
    <string name="onboarding_finish">Start protecting my neck</string>
    <string name="onboarding_step_indicator">Step %1$d of %2$d</string>
    <string name="onboarding_welcome_title">I\'m Likka, your nocturnal stag beetle</string>
    <string name="onboarding_welcome_body">I live in your phone and I can\'t stand seeing you slouch or stay glued to socials. I say it with love. Almost always.</string>
    <string name="onboarding_how_title">How it works</string>
    <string name="onboarding_how_intro">I ramp up my tone little by little, but you always have a way out.</string>
    <string name="onboarding_level_1_title">Level 1: Whisper</string>
    <string name="onboarding_level_1_body">I peek from the edge of the screen and drop a remark. You can carry on with what you\'re doing.</string>
    <string name="onboarding_level_2_title">Level 2: Annoyed</string>
    <string name="onboarding_level_2_body">I walk across the screen and tell you straight. Still not blocking anything.</string>
    <string name="onboarding_level_3_title">Level 3: Fury</string>
    <string name="onboarding_level_3_body">I take over most of the screen and, if you ignore me, I\'ll send you to the home screen.</string>
    <string name="onboarding_privacy_title">Privacy and AI</string>
    <string name="onboarding_permissions_title">Permissions</string>
    <string name="onboarding_permissions_intro">I need these permissions to take care of you. Without them, I can\'t appear or know which app you\'re using.</string>
    <string name="onboarding_permissions_required">Grant all permissions to continue.</string>
    <string name="onboarding_miui_title">Your phone settings</string>
    <string name="onboarding_miui_intro">Your phone closes background apps. Turn on these three options so it won\'t shut me down.</string>
    <string name="onboarding_miui_autostart_title">Autostart</string>
    <string name="onboarding_miui_autostart_body">Allows me to restart automatically when you turn on your phone.</string>
    <string name="onboarding_miui_battery_title">No restrictions on battery</string>
    <string name="onboarding_miui_battery_body">Prevents battery saver from closing me.</string>
    <string name="onboarding_miui_popup_title">Display pop-up windows in background</string>
    <string name="onboarding_miui_popup_body">Required so I can appear over other apps.</string>
    <string name="onboarding_miui_open_settings">Open settings</string>
    <string name="onboarding_miui_confirmed">I already turned it on</string>
    <string name="onboarding_done_title">All set!</string>
    <string name="onboarding_done_body">I\'m on guard now. Slouch or overstay on socials, and you\'ll definitely hear from me.</string>

