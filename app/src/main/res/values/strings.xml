    <!-- Privacy (onboarding step 3 and Settings › Qué datos se envían), documentación §8 -->
    <string name="privacy_title">Qué datos se envían</string>
    <string name="privacy_intro">Para que mis mensajes sean ingeniosos, le paso a mi servidor intermedio solo el nombre de la app (o «otra app» si la añadiste tú), cuántos minutos llevas, el ángulo de tu teléfono, y el nivel y motivo del aviso. Él se lo pasa a un servicio de IA (DeepSeek). Nada más.</string>
    <string name="privacy_sent_title">Lo que recibe el servicio de IA</string>
    <string name="privacy_sent_app">La app en uso: TikTok, Instagram, YouTube o Facebook. Si es una app que añadiste tú, solo «otra app». Nunca el nombre del paquete ni el nombre de tu app.</string>
    <string name="privacy_sent_minutes">Los minutos de uso. Mi servidor intermedio los redondea de 5 en 5 (hasta 240) antes de pasarlos.</string>
    <string name="privacy_sent_angle">El ángulo del teléfono. Mi servidor intermedio lo redondea de 5 en 5 (entre 0 y 90) antes de pasarlo.</string>
    <string name="privacy_sent_level">El nivel y el motivo del aviso.</string>
    <string name="privacy_never_title">Lo que nunca sale del teléfono</string>
    <string name="privacy_never_identity">Tu nombre, tu cuenta, tu ubicación o el identificador del dispositivo.</string>
    <string name="privacy_never_content">Lo que ves en la pantalla.</string>
    <string name="privacy_never_history">Tu historial y tus estadísticas: se quedan en el teléfono.</string>
    <string name="privacy_ip_title">Tu dirección IP</string>
    <string name="privacy_ip_body">Sí llega a mi servidor intermedio, que es el que habla con la IA. A la IA no le llega: ahí solo se ve la IP de Cloudflare.</string>
    <string name="privacy_limits_note">Lo que DeepSeek haga con esos datos no lo controlo. Por eso le paso lo mínimo.</string>
    <string name="privacy_ai_switch">Usar IA para los mensajes de Likka</string>
    <string name="privacy_ai_switch_hint">Si la apagas, sigo funcionando con frases locales y sin conexión a internet.</string>

    <!-- Onboarding (design system §3.1) -->
    <string name="onboarding_start">Empezar</string>
    <string name="onboarding_next">Continuar</string>
    <string name="onboarding_back">Atrás</string>
    <string name="onboarding_finish">Comenzar a cuidar mi cuello</string>
    <string name="onboarding_step_indicator">Paso %1$d de %2$d</string>
    <string name="onboarding_welcome_title">Soy Likka, tu escarabajo de la noche</string>
    <string name="onboarding_welcome_body">Vivo en tu teléfono y me molesta que te encorves o te quedes pegado a las redes. Te lo digo con cariño. Casi siempre.</string>
    <string name="onboarding_how_title">Cómo funciona</string>
    <string name="onboarding_how_intro">Subo de tono poco a poco, pero siempre tienes una salida.</string>
    <string name="onboarding_level_1_title">Nivel 1: Susurro</string>
    <string name="onboarding_level_1_body">Me asomo por el borde de la pantalla y suelto un comentario. Puedes seguir con lo tuyo.</string>
    <string name="onboarding_level_2_title">Nivel 2: Molesto</string>
    <string name="onboarding_level_2_body">Camino por la pantalla y te lo digo sin rodeos. Sigo sin bloquear nada.</string>
    <string name="onboarding_level_3_title">Nivel 3: Furia</string>
    <string name="onboarding_level_3_body">Ocupo casi toda la pantalla y, si no me haces caso, te mando al inicio del teléfono.</string>
    <string name="onboarding_privacy_title">Privacidad e IA</string>
    <string name="onboarding_permissions_title">Permisos</string>
    <string name="onboarding_permissions_intro">Necesito estos permisos para cuidarte. Sin ellos no puedo aparecer ni saber qué app usas.</string>
    <string name="onboarding_permissions_required">Concede todos los permisos para continuar.</string>
    <string name="onboarding_miui_title">Ajustes de Xiaomi</string>
    <string name="onboarding_miui_intro">Tu teléfono cierra las apps en segundo plano. Activa estas tres opciones para que no me apague.</string>
    <string name="onboarding_miui_autostart_title">Inicio automático</string>
    <string name="onboarding_miui_autostart_body">Permite que vuelva a arrancar solo cuando enciendas el teléfono.</string>
    <string name="onboarding_miui_battery_title">Batería sin restricciones</string>
    <string name="onboarding_miui_battery_body">Evita que el ahorro de batería me cierre.</string>
    <string name="onboarding_miui_popup_title">Ventanas emergentes en segundo plano</string>
    <string name="onboarding_miui_popup_body">Necesario para que pueda aparecer sobre otras apps.</string>
    <string name="onboarding_miui_open_settings">Abrir ajustes</string>
    <string name="onboarding_miui_confirmed">Ya lo activé</string>
    <string name="onboarding_done_title">¡Listo!</string>
    <string name="onboarding_done_body">Ya estoy en guardia. Si te encorvas o te pegas de más a las redes, te lo voy a decir.</string>

